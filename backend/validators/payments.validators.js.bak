import { z } from "zod";

const safeId = z
  .string()
  .trim()
  .min(3, "ID is too short")
  .max(150, "ID is too long");

const piUid = z
  .string()
  .trim()
  .min(3, "UID is too short")
  .max(120, "UID is too long");

const username = z
  .string()
  .trim()
  .min(1, "Username is required")
  .max(80, "Username is too long");

export const createPaymentRecordSchema = z.object({
  uid: piUid,

  username,

  amount: z.coerce
    .number()
    .positive("Amount must be positive")
    .max(100000, "Amount is too high"),

  memo: z
    .string()
    .trim()
    .max(250, "Memo is too long")
    .optional(),

  metadata: z
    .record(z.string(), z.any())
    .optional()
});

export const approvePaymentSchema = z.object({
  localPaymentId: safeId,
  paymentId: safeId
});

export const completePaymentSchema = z.object({
  localPaymentId: safeId,
  paymentId: safeId,
  txid: safeId,

  uid: piUid.optional(),

  username: z
    .string()
    .trim()
    .min(1, "Username is too short")
    .max(80, "Username is too long")
    .optional()
});

export const userStatusQuerySchema = z.object({
  uid: piUid
});